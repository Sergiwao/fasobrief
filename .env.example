# ==============================================================================
# FasoBrief - Configuration d'Exemple (Aucun secret réel)
# Sprint Technique Pré-Hackathon 226 - MTDPCE / DGTD (Édition 2026)
# ==============================================================================

# Port d'écoute du serveur auto-hébergé
PORT=3000
NODE_ENV=production

# Chemin de stockage de la base de données SQLite locale
DATABASE_PATH=./data/fasobrief.sqlite

# Mode démonstration Jury (0 = désactivé par défaut en production, 1 = active l'aide TOTP pour les comptes fictifs)
FASOBRIEF_DEMO_MODE=0
