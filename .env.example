# ==============================================================================
# FasoBrief - Environnement d'Exemple (Aucun secret réel)
# Sprint Technique Pré-Hackathon 226 - MTDPCE / DGTD (Édition 2026)
# ==============================================================================

# Port d'écoute du serveur souverain
PORT=3000
NODE_ENV=production

# Clé secrète pour signature des sessions JWT internes (À remplacer en production)
JWT_SECRET=fasobrief-secret-token-demonstration-prehackathon-2026

# Chemin de stockage de la base de données SQLite
DATABASE_PATH=./data/fasobrief.sqlite

# Chemin de stockage des pièces jointes chiffrées (blobs binaires E2EE)
UPLOAD_DIR=./data/uploads

# Niveau de journalisation
LOG_LEVEL=info
